{

    "Default": {
        "rate_limit": 1000,
        "timeout": 20000,
        "pre_delay": 200,
        "post_delay": 1000,
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "Click"
        },
        "focus": {
            "Node.Recognition.Starting": "{name}",
            "Node.Recognition.Succeeded": "[color:green]{name}",
            "Node.Recognition.Failed": "[color:red]{name}-节点识别失败"
        }
    },
    "LongPress": {
        "action": "LongPress",
        "target": true,
        "duration": 1000
    },
    "Swipe": {
        "action": "Swipe",
        "duration": 200
    }
}
